#!/usr/bin/env bash

set -u

usage() {
  printf 'Usage: herdr-theme <gentleman|gentleman-cute|gentleman-blue>\n' >&2
}

candidate=

assemble_profile() {
  local theme=$1
  local config_dir="$HOME/.config/herdr"
  local config_path="$config_dir/config.toml"
  local base="$config_dir/config-base.toml"
  local profile="$config_dir/profiles/$theme.toml"

  if [ ! -r "$base" ] || [ ! -r "$profile" ]; then
    printf 'Herdr theme sources are unavailable. Re-run Home Manager activation.\n' >&2
    return 1
  fi

  mkdir -p "$config_dir"
  if ! candidate="$(mktemp "$config_dir/.config.toml.XXXXXX")"; then
    printf 'Unable to create a Herdr theme candidate.\n' >&2
    return 1
  fi
  trap 'rm -f "$candidate"' EXIT HUP INT TERM

  if ! cat "$base" "$profile" > "$candidate"; then
    printf 'Unable to assemble Herdr theme candidate.\n' >&2
    return 1
  fi

  if ! chmod u+w "$candidate"; then
    printf 'Unable to make the Herdr theme candidate writable.\n' >&2
    return 1
  fi

  if ! mv -f "$candidate" "$config_path"; then
    printf 'Unable to activate the Herdr theme candidate.\n' >&2
    return 1
  fi
  trap - EXIT HUP INT TERM
}

install_default() {
  local config_path="$HOME/.config/herdr/config.toml"

  if [ -e "$config_path" ] || [ -L "$config_path" ]; then
    printf 'Preserving existing Herdr config\n'
    return 0
  fi

  if assemble_profile gentleman-blue; then
    printf 'Installed Gentleman Blue as the initial Herdr config\n'
    return 0
  fi

  printf 'Unable to write the initial Herdr config\n' >&2
  return 1
}

if [ "$#" -eq 1 ] && [ "$1" = --install-default ]; then
  install_default
  exit $?
fi

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

theme="$1"
case "$theme" in
  gentleman|gentleman-cute|gentleman-blue) ;;
  *)
    printf 'Unknown theme: %s\n' "$theme" >&2
    usage
    exit 2
    ;;
esac

assemble_profile "$theme" || exit $?
printf 'Herdr theme selected: %s\n' "$theme"

if ! command -v herdr >/dev/null 2>&1; then
  printf 'Herdr is not installed; the selection applies once it is.\n' >&2
  exit 0
fi

if ! herdr server reload-config; then
  printf 'Warning: Herdr could not reload its server; the selection remains active for the next start.\n' >&2
fi
