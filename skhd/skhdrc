# skhd configuration migrated from AeroSpace.

# ──────────────────────────────────────────────────────────────────────────────
# Native BSP placement and fullscreen
# These bindings keep windows managed. If the focused window is floating, the
# helper returns it to the bsp tree before native warp/reflow commands run.
# BSP placement is tree movement, not exact geometric grid snapping.
# ──────────────────────────────────────────────────────────────────────────────
alt + ctrl - h : ~/.config/yabai/snap-window.sh left
alt + ctrl - j : ~/.config/yabai/snap-window.sh bottom
alt + ctrl - k : ~/.config/yabai/snap-window.sh top
alt + ctrl - l : ~/.config/yabai/snap-window.sh right
alt + shift + ctrl - h : ~/.config/yabai/snap-window.sh top-left
alt + shift + ctrl - j : ~/.config/yabai/snap-window.sh bottom-left
alt + shift + ctrl - k : ~/.config/yabai/snap-window.sh bottom-right
alt + shift + ctrl - l : ~/.config/yabai/snap-window.sh top-right
alt + ctrl - return : yabai -m window --toggle zoom-fullscreen

# ──────────────────────────────────────────────────────────────────────────────
# Native BSP layout controls
# ──────────────────────────────────────────────────────────────────────────────
alt + ctrl - s : ~/.config/yabai/ensure-managed-window.sh && yabai -m window --toggle split
alt + ctrl - m : ~/.config/yabai/ensure-managed-window.sh && yabai -m window --ratio abs:0.45
alt + ctrl - r : yabai -m space --rotate 90
alt + ctrl - x : yabai -m space --mirror x-axis
alt + ctrl - y : yabai -m space --mirror y-axis

# ──────────────────────────────────────────────────────────────────────────────
# Window focus and managed window movement
# ──────────────────────────────────────────────────────────────────────────────
alt - h : yabai -m window --focus west >/dev/null 2>&1 || true
alt - j : yabai -m window --focus south >/dev/null 2>&1 || true
alt - k : yabai -m window --focus north >/dev/null 2>&1 || true
alt - l : yabai -m window --focus east >/dev/null 2>&1 || true

alt + cmd - h : ~/.config/yabai/ensure-managed-window.sh && yabai -m window --swap west
alt + cmd - j : ~/.config/yabai/ensure-managed-window.sh && yabai -m window --swap south
alt + cmd - k : ~/.config/yabai/ensure-managed-window.sh && yabai -m window --swap north
alt + cmd - l : ~/.config/yabai/ensure-managed-window.sh && yabai -m window --swap east

# ──────────────────────────────────────────────────────────────────────────────
# Spaces and displays
# ──────────────────────────────────────────────────────────────────────────────
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7

alt + shift - 1 : ~/.config/yabai/move-window-to-space.sh 1
alt + shift - 2 : ~/.config/yabai/move-window-to-space.sh 2
alt + shift - 3 : ~/.config/yabai/move-window-to-space.sh 3
alt + shift - 4 : ~/.config/yabai/move-window-to-space.sh 4
alt + shift - 5 : ~/.config/yabai/move-window-to-space.sh 5
alt + shift - 6 : ~/.config/yabai/move-window-to-space.sh 6
alt + shift - 7 : ~/.config/yabai/move-window-to-space.sh 7

alt - tab : yabai -m space --focus recent

# ──────────────────────────────────────────────────────────────────────────────
# Maintenance and recovery
# ──────────────────────────────────────────────────────────────────────────────
alt + ctrl - space : ~/.config/yabai/focus-current-space-window.sh
alt + ctrl + shift - r : /bin/launchctl kickstart -k gui/$(/usr/bin/id -u)/com.asmvik.yabai; skhd --restart-service
