#!/bin/bash

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                      GENTLEMAN SKETCHYBAR // NIGHT CITY                       ║
# ║                  Cyberpunk Holo-Panels - Neon Glow Style                      ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

PLUGIN_DIR="$CONFIG_DIR/plugins"
# Load the selected profile's semantic colors. Layout, labels, spacing, commands,
# and animation remain Night City-specific while the profile owns every color.
# CONFIG_DIR is supplied by SketchyBar at runtime.
# shellcheck disable=SC1091
source "$CONFIG_DIR/theme.sh"

# ─────────────────────────────────────────────────────────────────────────────────
# BAR APPEARANCE (transparent base for floating holo-panels)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --bar \
  height=25 \
  blur_radius=0 \
  position=top \
  sticky=on \
  padding_left=8 \
  padding_right=8 \
  color="$PANEL_BG" \
  corner_radius=0 \
  y_offset=-50 \
  margin=0 \
  notch_width=188 \
  notch_offset=0

# Startup animation - slide down from top
sketchybar --animate sin 12 --bar y_offset=-50 y_offset=2

# ─────────────────────────────────────────────────────────────────────────────────
# DEFAULT VALUES
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --default \
  icon.font="IosevkaTerm NFM:Bold:14.0" \
  icon.color="$CYAN" \
  label.font="IosevkaTerm NFM:Medium:13.0" \
  label.color="$TEXT" \
  background.color="$ISLAND_BG" \
  background.border_color="$ISLAND_BORDER" \
  background.border_width=1 \
  background.corner_radius=0 \
  background.height=32 \
  padding_left=6 \
  padding_right=6 \
  label.padding_left=6 \
  label.padding_right=8 \
  icon.padding_left=10 \
  icon.padding_right=4

# ═══════════════════════════════════════════════════════════════════════════════
#                                LEFT SIDE
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# SPACES (YABAI WORKSPACES) - sector chips, active one glows electric blue
# ─────────────────────────────────────────────────────────────────────────────────
for sid in $(seq 1 10); do
  # Space 2 shows its semantic name; the rest show their zero-padded number.
  if [ "$sid" -eq 2 ]; then
    SPACE_LABEL="Dev"
  else
    SPACE_LABEL="$(printf '%02d' "$sid")"
  fi
  sketchybar --add space "space.$sid" left \
    --set "space.$sid" \
      space="$sid" \
      icon.drawing=off \
      label="$SPACE_LABEL" \
      label.padding_left=8 \
      label.padding_right=8 \
      label.color="$DIM" \
      label.font="IosevkaTerm NF:Regular:12.0" \
      padding_left=2 \
      padding_right=2 \
      background.color="$ISLAND_BG" \
      background.border_color="$ISLAND_BORDER" \
      background.border_width=1 \
      background.corner_radius=0 \
      background.height=24 \
      background.drawing=on \
      script="$PLUGIN_DIR/space.sh" \
      click_script="yabai -m space --focus $sid" \
    --subscribe "space.$sid" space_change
done

# ─────────────────────────────────────────────────────────────────────────────────
# SEPARATOR (glitch slashes between sectors and front app)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item separator_left left \
  --set separator_left \
    icon="//" \
    icon.color="$PRIMARY" \
    icon.font="IosevkaTerm NF:Bold:16.0" \
    icon.padding_left=8 \
    icon.padding_right=8 \
    background.drawing=off \
    label.drawing=off

# ─────────────────────────────────────────────────────────────────────────────────
# FRONT APP (electric-blue ID tag, black text - Night City signage)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item front_app left \
  --set front_app \
    icon.drawing=off \
    label.font="IosevkaTerm NF:Bold:12.0" \
    label.color="$FOCUSED_TEXT" \
    label.padding_left=10 \
    label.padding_right=10 \
    label.max_chars=16 \
    scroll_texts=on \
    background.color="$FOCUSED_BG" \
    background.border_color="$FOCUSED_BG" \
    background.border_width=0 \
    background.corner_radius=0 \
    background.height=24 \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# ─────────────────────────────────────────────────────────────────────────────────
# AI QUOTA PANELS (left side, next to app names - all providers grouped here)
# Visual order (left to right): Copilot | Claude | OpenAI | OpenCode Go
# ─────────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────────
# OPENCODE GO QUOTA (5h + weekly, monthly shown in detail on click)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item opencode_quota left \
  --set opencode_quota \
  icon="⧈" \
  icon.font="IosevkaTerm NF:Bold:35.0" \
  icon.color=$WHITE \
  icon.padding_left=2 \
  icon.padding_right=1 \
  label.padding_left=1 \
  label.padding_right=2 \
  label.width=30 \
  label.align=right \
  scroll_texts=off \
  background.drawing=off \
  update_freq=60 \
  script="$PLUGIN_DIR/ai_quota.sh opencode-go" \
  click_script="$PLUGIN_DIR/ai_quota.sh opencode-go click"

sketchybar --add item opencode_quota_separator left \
  --set opencode_quota_separator \
  icon.drawing=off \
  label="|" \
  label.color=$DIM \
  padding_left=-6 \
  padding_right=-6 \
  label.padding_left=0 \
  label.padding_right=1 \
  label.width=10 \
  label.align=center \
  background.drawing=off

sketchybar --add item opencode_quota_weekly left \
  --set opencode_quota_weekly \
  icon.drawing=off \
  label="--" \
  label.color=$WHITE \
  label.padding_left=2 \
  label.padding_right=2 \
  label.width=28 \
  label.align=right \
  background.drawing=off \
  update_freq=60 \
  script="$PLUGIN_DIR/ai_quota.sh opencode-go weekly" \
  click_script="$PLUGIN_DIR/ai_quota.sh opencode-go weekly click"

# ─────────────────────────────────────────────────────────────────────────────────
# COPILOT QUOTA
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item copilot_quota left \
  --set copilot_quota \
  icon="" \
  icon.font="IosevkaTerm NF:Bold:14.0" \
  icon.color=$PRIMARY \
  icon.padding_left=6 \
  icon.padding_right=2 \
  label.padding_right=6 \
  label.width=40 \
  label.align=right \
  scroll_texts=off \
  background.color=$ISLAND_BG \
  background.border_color=$GLOW_BLUE \
  background.border_width=1 \
  background.corner_radius=0 \
  background.height=24 \
  update_freq=60 \
  script="$PLUGIN_DIR/ai_quota.sh copilot" \
  click_script="$PLUGIN_DIR/ai_quota.sh copilot click"

# ─────────────────────────────────────────────────────────────────────────────────
# CLAUDE QUOTA
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item claude_quota left \
  --set claude_quota \
  icon="✴" \
  icon.font="IosevkaTerm NF:Bold:35.0" \
  icon.color=$ORANGE \
  icon.padding_left=2 \
  icon.padding_right=1 \
  label.padding_left=1 \
  label.padding_right=2 \
  label.width=30 \
  label.align=right \
  scroll_texts=off \
  background.drawing=off \
  update_freq=60 \
  script="$PLUGIN_DIR/ai_quota.sh claude" \
  click_script="$PLUGIN_DIR/ai_quota.sh claude click"

sketchybar --add item claude_quota_separator left \
  --set claude_quota_separator \
  icon.drawing=off \
  label="|" \
  label.color=$DIM \
  padding_left=-6 \
  padding_right=-6 \
  label.padding_left=0 \
  label.padding_right=1 \
  label.width=10 \
  label.align=center \
  background.drawing=off

sketchybar --add item claude_quota_weekly left \
  --set claude_quota_weekly \
  icon.drawing=off \
  label="--" \
  label.color=$WHITE \
  label.padding_left=2 \
  label.padding_right=2 \
  label.width=28 \
  label.align=right \
  background.drawing=off \
  click_script="$PLUGIN_DIR/ai_quota.sh claude weekly click"

# ─────────────────────────────────────────────────────────────────────────────────
# OPENAI QUOTA
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item openai_quota left \
  --set openai_quota \
  icon="֎" \
  icon.font="IosevkaTerm NF:Bold:35.0" \
  icon.color=$WHITE \
  icon.padding_left=2 \
  icon.padding_right=1 \
  label.padding_left=1 \
  label.padding_right=2 \
  label.width=30 \
  label.align=right \
  scroll_texts=off \
  background.drawing=off \
  update_freq=60 \
  script="$PLUGIN_DIR/ai_quota.sh openai" \
  click_script="$PLUGIN_DIR/ai_quota.sh openai click"

sketchybar --add item openai_quota_separator left \
  --set openai_quota_separator \
  icon.drawing=off \
  label="|" \
  label.color=$DIM \
  padding_left=-6 \
  padding_right=-6 \
  label.padding_left=0 \
  label.padding_right=1 \
  label.width=10 \
  label.align=center \
  background.drawing=off

sketchybar --add item openai_quota_weekly left \
  --set openai_quota_weekly \
  icon.drawing=off \
  label="--" \
  label.color=$WHITE \
  label.padding_left=2 \
  label.padding_right=2 \
  label.width=28 \
  label.align=right \
  background.drawing=off \
  update_freq=60 \
  script="$PLUGIN_DIR/ai_quota.sh openai weekly" \
  click_script="$PLUGIN_DIR/ai_quota.sh openai weekly click"

# Spacer between provider boxes
sketchybar --add item ai_provider_gap left \
  --set ai_provider_gap \
  icon.drawing=off \
  label.drawing=off \
  background.drawing=off \
  width=6

# Spacer between OpenAI and OpenCode Go boxes
sketchybar --add item ai_provider_gap2 left \
  --set ai_provider_gap2 \
  icon.drawing=off \
  label.drawing=off \
  background.drawing=off \
  width=6

# Spacer shown only while AI quota panels are hidden
sketchybar --add item ai_hidden_gap left \
  --set ai_hidden_gap \
  drawing=off \
  icon.drawing=off \
  label.drawing=off \
  background.drawing=off \
  width=6

# Shared container per provider (5h + weekly in same box)
sketchybar --add bracket opencode_box opencode_quota opencode_quota_separator opencode_quota_weekly \
  --set opencode_box \
  background.color=$ISLAND_BG \
  background.border_color=$GLOW_GREEN \
  background.border_width=1 \
  background.corner_radius=0 \
  background.height=24

sketchybar --add bracket claude_box claude_quota claude_quota_separator claude_quota_weekly \
  --set claude_box \
  background.color=$ISLAND_BG \
  background.border_color=$GLOW_AMBER \
  background.border_width=1 \
  background.corner_radius=0 \
  background.height=24

sketchybar --add bracket openai_box openai_quota openai_quota_separator openai_quota_weekly \
  --set openai_box \
  background.color=$ISLAND_BG \
  background.border_color=$GLOW_VIOLET \
  background.border_width=1 \
  background.corner_radius=0 \
  background.height=24

# Ensure provider order inside each box: icon+5h | separator | weekly
sketchybar --move claude_quota_separator after claude_quota
sketchybar --move claude_quota_weekly after claude_quota_separator
sketchybar --move openai_quota_separator after openai_quota
sketchybar --move openai_quota_weekly after openai_quota_separator
sketchybar --move opencode_quota_separator after opencode_quota
sketchybar --move opencode_quota_weekly after opencode_quota_separator
# Box order (left to right): Copilot | Claude | gap | OpenAI | gap | OpenCode Go
# Move OpenCode Go block to the end (it was added first so it starts leftmost)
sketchybar --move opencode_quota after openai_quota_weekly
sketchybar --move opencode_quota_separator after opencode_quota
sketchybar --move opencode_quota_weekly after opencode_quota_separator
# Place gaps between boxes
sketchybar --move ai_provider_gap before openai_quota
sketchybar --move ai_provider_gap2 before opencode_quota

# ═══════════════════════════════════════════════════════════════════════════════
#                                RIGHT SIDE
# ═══════════════════════════════════════════════════════════════════════════════
# Visual order (right to left): DateTime | Battery | RAM | CPU | GPU | gap | AI toggle | AI detail | camera gap

# ─────────────────────────────────────────────────────────────────────────────────
# DATETIME (rightmost - blue glow panel)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item datetime right \
  --set datetime \
    icon.drawing=off \
    label.color="$CYAN" \
    label.padding_left=6 \
    label.padding_right=6 \
    background.color="$ISLAND_BG" \
    background.border_color="$GLOW_BLUE" \
    background.border_width=1 \
    background.corner_radius=0 \
    background.height=24 \
    update_freq=10 \
    script="$PLUGIN_DIR/datetime.sh" \
    click_script="$PLUGIN_DIR/datetime.sh"

# ─────────────────────────────────────────────────────────────────────────────────
# BATTERY
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item battery right \
  --set battery \
    icon.font="IosevkaTerm NF:Bold:14.0" \
    icon.color="$BATTERY_HEALTHY" \
    icon.padding_left=8 \
    icon.padding_right=3 \
    padding_right=0 \
    label.padding_right=6 \
    label.width=34 \
    label.align=right \
    background.color="$ISLAND_BG" \
    background.border_color="$ISLAND_BORDER" \
    background.border_width=1 \
    background.corner_radius=0 \
    background.height=24 \
    update_freq=60 \
    script="$PLUGIN_DIR/battery.sh" \
    click_script="open -a 'System Preferences' /System/Library/PreferencePanes/Battery.prefPane" \
  --subscribe battery system_woke power_source_change

# ─────────────────────────────────────────────────────────────────────────────────
# MEETING (next calendar event)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item meeting right \
  --set meeting \
    icon="MTG" \
    icon.font="IosevkaTerm NF:Bold:10.0" \
    icon.color="$WARNING" \
    icon.padding_left=8 \
    icon.padding_right=3 \
    label.padding_right=6 \
    label.max_chars=12 \
    scroll_texts=on \
    background.color="$ISLAND_BG" \
    background.border_color="$GLOW_AMBER" \
    background.border_width=1 \
    background.corner_radius=0 \
    background.height=24 \
    update_freq=60 \
    script="$PLUGIN_DIR/meeting.sh" \
    click_script="open -a Calendar"

# ─────────────────────────────────────────────────────────────────────────────────
# VOLUME
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item volume right \
  --set volume \
    icon="VOL" \
    icon.font="IosevkaTerm NF:Bold:10.0" \
    icon.color="$VOLUME_NORMAL" \
    icon.padding_left=8 \
    icon.padding_right=3 \
    label.padding_right=6 \
    label.width=34 \
    label.align=right \
    background.color="$ISLAND_BG" \
    background.border_color="$GLOW_BLUE" \
    background.border_width=1 \
    background.corner_radius=0 \
    background.height=24 \
    script="$PLUGIN_DIR/volume.sh" \
    click_script="open -a 'System Preferences' /System/Library/PreferencePanes/Sound.prefPane" \
  --subscribe volume volume_change

# ─────────────────────────────────────────────────────────────────────────────────
# RAM
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item ram right \
  --set ram \
    icon="RAM" \
    icon.font="IosevkaTerm NF:Bold:10.0" \
    icon.color="$RAM_NORMAL" \
    padding_left=1 \
    padding_right=1 \
    icon.padding_left=4 \
    icon.padding_right=2 \
    label.padding_right=3 \
    label.width=28 \
    label.align=right \
    background.drawing=off \
    update_freq=10 \
    script="$PLUGIN_DIR/ram.sh" \
    click_script="open -a 'Activity Monitor'"

# ─────────────────────────────────────────────────────────────────────────────────
# CPU
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item cpu right \
  --set cpu \
    icon="CPU" \
    icon.font="IosevkaTerm NF:Bold:10.0" \
    icon.color="$CPU_INITIAL" \
    padding_left=1 \
    padding_right=1 \
    icon.padding_left=4 \
    icon.padding_right=2 \
    label.padding_right=3 \
    label.width=28 \
    label.align=right \
    background.drawing=off \
    update_freq=5 \
    script="$PLUGIN_DIR/cpu.sh" \
    click_script="open -a 'Activity Monitor'"

# ─────────────────────────────────────────────────────────────────────────────────
# GPU (Apple Silicon)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item gpu right \
  --set gpu \
    icon="GPU" \
    icon.font="IosevkaTerm NF:Bold:10.0" \
    icon.color="$GPU_NORMAL" \
    padding_left=1 \
    padding_right=1 \
    icon.padding_left=4 \
    icon.padding_right=2 \
    label.padding_right=3 \
    label.width=28 \
    label.align=right \
    background.drawing=off \
    update_freq=10 \
    script="$PLUGIN_DIR/gpu.sh" \
    click_script="open -a 'Activity Monitor'"

# Shared container for RAM/CPU/GPU (ice glow)
sketchybar --add bracket metrics_box ram cpu gpu \
  --set metrics_box \
    background.color="$ISLAND_BG" \
    background.border_color="$GLOW_ICE" \
    background.border_width=1 \
    background.corner_radius=0 \
    background.height=24 \
    background.padding_left=2 \
    background.padding_right=2

# Standard 6px gap between metrics_box and AI toggle
sketchybar --add item ai_toggle_gap right \
  --set ai_toggle_gap \
    icon.drawing=off \
    label.drawing=off \
    background.drawing=off \
    width=6

# ─────────────────────────────────────────────────────────────────────────────────
# AI VISIBILITY TOGGLE (hides/shows OpenAI + OpenCode Go quota panels on left)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item ai_toggle right \
  --set ai_toggle \
    icon="󰚩" \
    icon.font="IosevkaTerm NF:Bold:13.0" \
    icon.color="$PRIMARY" \
    icon.padding_left=6 \
    icon.padding_right=6 \
    label.drawing=off \
    padding_left=4 \
    padding_right=2 \
    background.color="$ISLAND_BG" \
    background.border_color="$GLOW_BLUE" \
    background.border_width=1 \
    background.corner_radius=0 \
    background.height=24 \
    click_script="$PLUGIN_DIR/ai_toggle.sh toggle"

# Detail box for AI quota click refresh (right side, next to toggle)
sketchybar --add item ai_detail right \
  --set ai_detail \
    icon.drawing=on \
    icon.padding_left=8 \
    icon.padding_right=4 \
    icon.color="$WHITE" \
    icon.font="IosevkaTerm NF:Bold:14.0" \
    drawing=off \
    label.font="IosevkaTerm NFM:Medium:13.0" \
    label.color="$WHITE" \
    label.padding_left=8 \
    label.padding_right=8 \
    background.color="$ISLAND_BG" \
    background.border_color="$GLOW_BLUE" \
    background.border_width=1 \
    background.corner_radius=0 \
    background.height=24

# ─────────────────────────────────────────────────────────────────────────────────
# CAMERA GAP (MacBook notch spacing)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item camera_gap right \
  --set camera_gap \
    icon.drawing=off \
    label.drawing=off \
    background.drawing=off \
    width=188

# ─────────────────────────────────────────────────────────────────────────────────
# FINALIZE
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --update

# Restore persisted AI panel visibility (hidden state survives reloads)
"$PLUGIN_DIR/ai_toggle.sh" apply
