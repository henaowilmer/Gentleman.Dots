#!/bin/bash

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                          GENTLEMAN SKETCHYBAR                                 ║
# ║                    Minimal Islands - Floating Style                           ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

PLUGIN_DIR="$CONFIG_DIR/plugins"

# ─────────────────────────────────────────────────────────────────────────────────
# GENTLEMAN COLOR PALETTE (matching Ghostty/Neovim theme)
# ─────────────────────────────────────────────────────────────────────────────────
export BLACK=0xff06080f
export WHITE=0xfff3f6f9
export RED=0xffcb7c94
export GREEN=0xffb7cc85
export YELLOW=0xffffe066
export ORANGE=0xffffa94d
export BLUE=0xff7fb4ca
export MAGENTA=0xffff8dd7
export CYAN=0xff7aa89f
export TRANSPARENT=0x00000000
export PRIMARY=0xff347aff

# Island colors
export ISLAND_BG=0xff121620
export ISLAND_BORDER=0xff263356
export ACCENT_COLOR=0xffe0c15a
export DIM=0xff565f89

# ─────────────────────────────────────────────────────────────────────────────────
# BAR APPEARANCE (transparent base for floating islands)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --bar \
  height=25 \
  blur_radius=0 \
  position=top \
  sticky=on \
  padding_left=8 \
  padding_right=8 \
  color=$TRANSPARENT \
  corner_radius=0 \
  y_offset=-50 \
  margin=0 \
  notch_width=188 \
  notch_offset=0

# Startup animation - slide down from top
sketchybar --animate sin 12 --bar y_offset=-50 y_offset=2

# ─────────────────────────────────────────────────────────────────────────────────
# DEFAULT VALUES
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --default \
  icon.font="IosevkaTerm NFM:Bold:14.0" \
  icon.color=$WHITE \
  label.font="IosevkaTerm NFM:Medium:13.0" \
  label.color=$WHITE \
  background.color=$ISLAND_BG \
  background.border_color=$ISLAND_BORDER \
  background.border_width=1 \
  background.corner_radius=12 \
  background.height=32 \
  padding_left=6 \
  padding_right=6 \
  label.padding_left=6 \
  label.padding_right=8 \
  icon.padding_left=10 \
  icon.padding_right=4

# ═══════════════════════════════════════════════════════════════════════════════
#                                LEFT SIDE
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# SPACES (YABAI WORKSPACES)
# ─────────────────────────────────────────────────────────────────────────────────
for sid in $(seq 1 10); do
  sketchybar --add space space.$sid left \
    --set space.$sid \
    space=$sid \
    icon.drawing=off \
    label="$sid" \
    label.padding_left=8 \
    label.padding_right=8 \
    label.color=$DIM \
    label.font="IosevkaTerm NF:Regular:12.0" \
    padding_left=2 \
    padding_right=2 \
    background.color=$ISLAND_BG \
    background.border_color=$ISLAND_BORDER \
    background.border_width=1 \
    background.corner_radius=4 \
    background.height=24 \
    background.drawing=on \
    script="$PLUGIN_DIR/space.sh" \
    click_script="yabai -m space --focus $sid" \
    --subscribe space.$sid space_change
done

# ─────────────────────────────────────────────────────────────────────────────────
# SEPARATOR (arrow between workspaces and front app)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item separator_left left \
  --set separator_left \
  icon=">" \
  icon.color=$ACCENT_COLOR \
  icon.font="IosevkaTerm NF:Bold:16.0" \
  icon.padding_left=8 \
  icon.padding_right=8 \
  background.drawing=off \
  label.drawing=off

# ─────────────────────────────────────────────────────────────────────────────────
# FRONT APP (current focused app)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item front_app left \
  --set front_app \
  icon.drawing=off \
  label.font="IosevkaTerm NF:Bold:12.0" \
  label.color=$BLACK \
  label.padding_left=10 \
  label.padding_right=10 \
  label.max_chars=16 \
  scroll_texts=on \
  background.color=$PRIMARY \
  background.border_color=$PRIMARY \
  background.border_width=0 \
  background.corner_radius=4 \
  background.height=24 \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# Detail box for AI quota click refresh (next to focused app)
sketchybar --add item ai_detail left \
  --set ai_detail \
  icon.drawing=off \
  drawing=off \
  label.font="IosevkaTerm NF:Medium:11.0" \
  label.color=$WHITE \
  label.padding_left=8 \
  label.padding_right=8 \
  background.color=$ISLAND_BG \
  background.border_color=$ISLAND_BORDER \
  background.border_width=1 \
  background.corner_radius=4 \
  background.height=24

# ═══════════════════════════════════════════════════════════════════════════════
#                                RIGHT SIDE
# ═══════════════════════════════════════════════════════════════════════════════
# Visual order (right to left): DateTime | Battery | RAM | CPU | GPU | Copilot | [camera gap] | Claude | OpenAI

# ─────────────────────────────────────────────────────────────────────────────────
# DATETIME (rightmost)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item datetime right \
  --set datetime \
  icon.drawing=off \
  label.padding_left=6 \
  label.padding_right=6 \
  background.color=$ISLAND_BG \
  background.border_color=$ISLAND_BORDER \
  background.border_width=1 \
  background.corner_radius=4 \
  background.height=24 \
  update_freq=10 \
  script="$PLUGIN_DIR/datetime.sh" \
  click_script="$PLUGIN_DIR/datetime.sh"

# ─────────────────────────────────────────────────────────────────────────────────
# BATTERY
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item battery right \
  --set battery \
  icon.font="IosevkaTerm NF:Bold:14.0" \
  icon.color=$GREEN \
  icon.padding_left=8 \
  icon.padding_right=3 \
  label.padding_right=6 \
  label.width=34 \
  label.align=right \
  background.color=$ISLAND_BG \
  background.border_color=$ISLAND_BORDER \
  background.border_width=1 \
  background.corner_radius=4 \
  background.height=24 \
  update_freq=60 \
  script="$PLUGIN_DIR/battery.sh" \
  click_script="open -a 'System Preferences' /System/Library/PreferencePanes/Battery.prefPane" \
  --subscribe battery system_woke power_source_change

# ─────────────────────────────────────────────────────────────────────────────────
# RAM
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item ram right \
  --set ram \
  icon="RAM" \
  icon.font="IosevkaTerm NF:Bold:10.0" \
  icon.color=$MAGENTA \
  icon.padding_left=8 \
  icon.padding_right=3 \
  label.padding_right=6 \
  label.width=34 \
  label.align=right \
  background.color=$ISLAND_BG \
  background.border_color=$ISLAND_BORDER \
  background.border_width=1 \
  background.corner_radius=4 \
  background.height=24 \
  update_freq=10 \
  script="$PLUGIN_DIR/ram.sh" \
  click_script="open -a 'Activity Monitor'"

# ─────────────────────────────────────────────────────────────────────────────────
# CPU
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item cpu right \
  --set cpu \
  icon="CPU" \
  icon.font="IosevkaTerm NF:Bold:10.0" \
  icon.color=$RED \
  icon.padding_left=8 \
  icon.padding_right=3 \
  label.padding_right=6 \
  label.width=34 \
  label.align=right \
  background.color=$ISLAND_BG \
  background.border_color=$ISLAND_BORDER \
  background.border_width=1 \
  background.corner_radius=4 \
  background.height=24 \
  update_freq=5 \
  script="$PLUGIN_DIR/cpu.sh" \
  click_script="open -a 'Activity Monitor'"

# ─────────────────────────────────────────────────────────────────────────────────
# GPU (Apple Silicon)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item gpu right \
  --set gpu \
  icon="GPU" \
  icon.font="IosevkaTerm NF:Bold:10.0" \
  icon.color=$ORANGE \
  icon.padding_left=8 \
  icon.padding_right=3 \
  label.padding_right=6 \
  label.width=34 \
  label.align=right \
  background.color=$ISLAND_BG \
  background.border_color=$ISLAND_BORDER \
  background.border_width=1 \
  background.corner_radius=4 \
  background.height=24 \
  update_freq=10 \
  script="$PLUGIN_DIR/gpu.sh" \
  click_script="open -a 'Activity Monitor'"

# ─────────────────────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────────────────────
# COPILOT QUOTA
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item copilot_quota right \
  --set copilot_quota \
  icon="" \
  icon.font="IosevkaTerm NF:Bold:14.0" \
  icon.color=$PRIMARY \
  icon.padding_left=6 \
  icon.padding_right=2 \
  label.padding_right=6 \
  label.width=40 \
  label.align=right \
  scroll_texts=off \
  background.color=$ISLAND_BG \
  background.border_color=$ISLAND_BORDER \
  background.border_width=1 \
  background.corner_radius=4 \
  background.height=24 \
  update_freq=60 \
  script="$PLUGIN_DIR/ai_quota.sh copilot" \
  click_script="$PLUGIN_DIR/ai_quota.sh copilot click"

# ─────────────────────────────────────────────────────────────────────────────────
# CLAUDE QUOTA
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item claude_quota right \
  --set claude_quota \
  icon="✴" \
  icon.font="IosevkaTerm NF:Bold:35.0" \
  icon.color=$ORANGE \
  icon.padding_left=6 \
  icon.padding_right=2 \
  label.padding_right=6 \
  label.width=40 \
  label.align=right \
  scroll_texts=off \
  background.color=$ISLAND_BG \
  background.border_color=$ISLAND_BORDER \
  background.border_width=1 \
  background.corner_radius=4 \
  background.height=24 \
  update_freq=60 \
  script="$PLUGIN_DIR/ai_quota.sh claude" \
  click_script="$PLUGIN_DIR/ai_quota.sh claude click"

# ─────────────────────────────────────────────────────────────────────────────────
# OPENAI QUOTA
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item openai_quota right \
  --set openai_quota \
  icon="֎" \
  icon.font="IosevkaTerm NF:Bold:35.0" \
  icon.color=$WHITE \
  icon.padding_left=6 \
  icon.padding_right=2 \
  label.padding_right=6 \
  label.width=40 \
  label.align=right \
  scroll_texts=off \
  background.color=$ISLAND_BG \
  background.border_color=$ISLAND_BORDER \
  background.border_width=1 \
  background.corner_radius=4 \
  background.height=24 \
  update_freq=60 \
  script="$PLUGIN_DIR/ai_quota.sh openai" \
  click_script="$PLUGIN_DIR/ai_quota.sh openai click"

# ─────────────────────────────────────────────────────────────────────────────────
# CAMERA GAP (MacBook notch spacing)
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --add item camera_gap right \
  --set camera_gap \
  icon.drawing=off \
  label.drawing=off \
  background.drawing=off \
  width=188

# ─────────────────────────────────────────────────────────────────────────────────
# FINALIZE
# ─────────────────────────────────────────────────────────────────────────────────
sketchybar --update
